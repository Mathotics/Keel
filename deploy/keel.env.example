KEEL_HOST=0.0.0.0
KEEL_PORT=8000
KEEL_RELOAD=false
KEEL_LOG_LEVEL=info
KEEL_DATABASE_URL=sqlite+pysqlite:////mnt/library/keel-data/keel.db
# An empty production database keeps the service-account name and no password.
KEEL_SEED_SIGN_IN=false
# Password reset and username lookup hand mail to a separate SMTP service.
# Keel does not run a mail server. Nothing is sent until both of these are set.
# Add the login when that service requires one. Port 587 and STARTTLS are the defaults.
# KEEL_SMTP_HOST=
# KEEL_SMTP_PORT=587
# KEEL_SMTP_USERNAME=
# KEEL_SMTP_PASSWORD=
# KEEL_SMTP_FROM=
# KEEL_SMTP_STARTTLS=true
