KEEL_HOST=0.0.0.0
KEEL_PORT=8000
KEEL_RELOAD=false
KEEL_LOG_LEVEL=info
KEEL_DATABASE_URL=sqlite+pysqlite:////mnt/library/keel-data/keel.db
# An empty production database keeps the service-account name and no password.
KEEL_SEED_SIGN_IN=false
# Postfix on this Pi accepts mail on localhost and delivers it.
# Nothing is sent until the host and From address are set. No login for localhost.
# KEEL_SMTP_HOST=127.0.0.1
# KEEL_SMTP_PORT=25
# KEEL_SMTP_FROM=keel@example.com
# KEEL_SMTP_STARTTLS=false
