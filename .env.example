KEEL_HOST=127.0.0.1
KEEL_PORT=8000
KEEL_RELOAD=false
KEEL_LOG_LEVEL=info
# Defaults to a SQLite file in the OS user data directory.
# KEEL_DATABASE_URL=sqlite+pysqlite:///C:/path/to/keel.db
# Names the first person on an empty database, with no password.
# When unset, that person is username keel with password keel.
# KEEL_DEFAULT_USER=
# KEEL_SEED_SIGN_IN=true
# Password reset and username lookup need a separate SMTP service.
# Keel does not run a mail server. Leave these unset and nothing is sent.
# KEEL_SMTP_HOST=
# KEEL_SMTP_PORT=587
# KEEL_SMTP_USERNAME=
# KEEL_SMTP_PASSWORD=
# KEEL_SMTP_FROM=
# KEEL_SMTP_STARTTLS=true
