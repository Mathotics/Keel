KEEL_HOST=127.0.0.1
KEEL_PORT=8000
KEEL_RELOAD=false
KEEL_LOG_LEVEL=info
# Defaults to a SQLite file in the OS user data directory.
# KEEL_DATABASE_URL=sqlite+pysqlite:///C:/path/to/keel.db
# Names the first person on an empty database, with no password.
# When unset, that person is username keel with password keel.
# KEEL_DEFAULT_USER=
# KEEL_SEED_SIGN_IN=true
# Postfix on the same machine accepts mail on localhost and delivers it.
# Leave these unset and nothing is sent. No login for localhost.
# KEEL_SMTP_HOST=127.0.0.1
# KEEL_SMTP_PORT=25
# KEEL_SMTP_FROM=keel@example.com
# KEEL_SMTP_STARTTLS=false
